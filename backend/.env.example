BRIM_DATA_DIR=../data/brim_ap_dataset
DATABASE_URL=sqlite:///./brim.db
DEMO_MODE=true
# AI investigation agent (off by default; holds and payments never depend on it).
# AI_ENABLED=true + a key → live calls; responses are recorded to fixtures/ai/ when replay is on.
# AI_ENABLED=true + no key → replays recorded responses only (offline demo), else deterministic.
AI_ENABLED=false
AI_FIXTURE_REPLAY=true
AI_MODEL=claude-sonnet-5-5
AI_MAX_CALLS_PER_CASE=8
AI_DAILY_BUDGET_USD=5
AI_CASE_BUDGET_USD=0.50
# Used only for budget enforcement and cost logging; set to your plan's prices (USD per million tokens).
AI_INPUT_USD_PER_MTOK=3
AI_OUTPUT_USD_PER_MTOK=15
ANTHROPIC_API_KEY=
FRONTEND_ORIGIN=http://localhost:8080
BRIM_AS_OF_DATE=2026-11-02
# Local OCR (RapidOCR on ONNX Runtime; no network). Values read below the threshold are left blank.
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.80
# Per-actor limit on POST/PATCH requests per rolling minute (0 disables).
RATE_LIMIT_PER_MINUTE=120
